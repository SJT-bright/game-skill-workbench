const load=require('./papercut_production_loader.cjs'),path=require('path'),assert=require('assert'),fs=require('fs');
const root=process.argv[2]||path.resolve(__dirname,'../build/native');let checks=[];
function test(name,fn){try{fn();checks.push({name,pass:true})}catch(e){checks.push({name,pass:false,error:e.message})}}
function env(missing=null,mode='normal',seed){let values=new Map(seed||[]);const storage={getItem(k){if(mode==='read_error')throw Error('read failed');if(mode==='readback'&&values.has(k))return '{}';return values.has(k)?values.get(k):missing},setItem(k,v){if(mode==='write_error')throw Error('write failed');values.set(k,v)}};const {GameData:D}=load(root,storage);return {D,storage,values,d:D.GetInstance()}}
for(const missing of [null,undefined,''])test('missing_'+String(missing),()=>{const e=env(missing);e.d.init();assert.equal(e.d.power,5);assert.equal(e.d.lv,1);assert.equal(e.D.commitRewardedAdPower('a',3),true);assert.equal(e.d.power,8)});
for(const invalid of ['bad','{}','false','0',JSON.stringify({version:99,power:7,claimed:{}})])test('malformed_preserved_'+invalid,()=>{const e=env();e.values.set(e.D.platformEnergyStateKey(),invalid);e.d.init();assert.equal(e.values.get(e.D.platformEnergyStateKey()),invalid);assert.equal(e.D.commitRewardedAdPower('a',3),false)});
for(const mode of ['read_error','write_error','readback'])test(mode,()=>{const e=env(null,mode);e.d.init();const before=e.d.power;assert.equal(e.D.commitRewardedAdPower('a',3),false);assert.equal(e.d.power,before)});
for(const power of [0,1,5,10])for(const shortcut of [false,true])test('legacy_'+power+'_'+shortcut,()=>{const e=env();e.values.set(e.D.platformEnergyStateKey(),JSON.stringify({version:1,power,claimed:{shortcut,profile:false}}));e.d.init();assert.equal(e.d.power,power);assert.equal(e.d.shortcutRewardClaimed,shortcut)});
test('duplicate_ad_once',()=>{const e=env();e.d.init();e.D.commitRewardedAdPower('same',2);e.D.commitRewardedAdPower('same',2);assert.equal(e.d.power,7)});
test('grant_consume_restart',()=>{const e=env();e.d.init();e.D.commitRewardedAdPower('r',3);e.d.costPower();e.D._instance=null;const d=e.D.GetInstance();d.init();assert.equal(d.power,7)});
test('mission_idempotence',()=>{const e=env();e.d.init();const q=load(root,e.storage).platform.GROWTH_REWARDS.profile;e.D.commitPlatformMissionReward('profile',q.amount,q.claimKey);e.D.commitPlatformMissionReward('profile',q.amount,q.claimKey);assert.equal(e.d.power,8)});
test('wrong_mission_rejected',()=>{const e=env();e.d.init();assert.equal(e.D.commitPlatformMissionReward('profile',99,'wrong'),false);assert.equal(e.d.power,5)});
test('progress_restart',()=>{const e=env();e.d.init();e.D.lvUP(8);e.D._instance=null;const d=e.D.GetInstance();d.init();assert.equal(d.lv,8)});
for(const mode of ['write_error','readback'])test('progress_'+mode,()=>{const e=env(null,mode);e.d.init();e.values.set('lv','1');e.D.lvUP(8);assert.equal(e.d.lv,1)});
const report={tool:'papercut_production_storage',root,passed:checks.every(c=>c.pass),checks};const out=process.argv[3];if(out)fs.writeFileSync(out,JSON.stringify(report,null,2));console.log(JSON.stringify(report));process.exitCode=report.passed?0:1;
