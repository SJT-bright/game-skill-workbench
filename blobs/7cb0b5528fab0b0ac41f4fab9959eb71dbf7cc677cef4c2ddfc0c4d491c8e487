'use strict';
// Real child processes over tiny fixtures; no game, browser, SDK or production suite matrix.
const assert=require('node:assert/strict'),fs=require('node:fs'),path=require('node:path'),os=require('node:os'),cp=require('node:child_process');
const R=require('./suite-runner.cjs'),root=fs.mkdtempSync(path.join(os.tmpdir(),'suite-ledger-controls-'));
let count=0;function test(name,fn){try{fn();count++;console.log('PASS '+name);}catch(e){console.error('FAIL '+name,e.stack);process.exitCode=1;}}
const kit='remake-core/assets/platform-kit/',dir=path.join(root,kit,'tests');fs.mkdirSync(dir,{recursive:true});
function put(n,v){const p=path.join(root,n);fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,v);}
put('dep-a.txt','good');put('dep-b.txt','good');
for(const name of ['a','b'])put(kit+'tests/'+name+'.js',`const fs=require('fs'),path=require('path');if(fs.readFileSync(path.join(__dirname,'../../../../dep-${name}.txt'),'utf8')!=='good')throw Error('bad dependency');console.log('${name} real child passed');`);
function contract(){const entries=['a','b'].map(n=>{const f=kit+'tests/'+n+'.js';return {id:n,script:'tests/'+n+'.js',context:'default',inputs:[f,'dep-'+n+'.txt'],input_patterns:[f,'dep-'+n+'.txt'],required_inputs:[f,'dep-'+n+'.txt'],absent_inputs:[],audited_sources:{[f]:R.hash(fs.readFileSync(path.join(root,f)))},environment_inputs:[],timeout_ms:5000};});fs.writeFileSync(path.join(root,'contracts.json'),JSON.stringify({schema:'platform-suite-contracts.v1',entries,groups:entries.map(e=>({id:e.id,label:e.id,children:[e.id]}))}));}
contract();let serial=0;const cache=path.join(root,'cache');function run(extra={}){return R.run({tree:root,contracts:path.join(root,'contracts.json'),cache,report:path.join(root,'runs',String(++serial)+'.json'),runId:'control-batch',...extra});}
let first,last;
test('cold run executes each child exactly once',()=>{first=run();assert.deepEqual(first.value.counts,{executed:2,reused:0});assert(first.value.passed);});
test('unchanged run consumes both original outputs',()=>{last=run();assert.deepEqual(last.value.counts,{executed:0,reused:2});assert.equal(last.value.results[0].producer.id,first.value.results[0].producer.id);});
test('one true dependency invalidates one child and failure blocks',()=>{put('dep-a.txt','bad');const x=run();assert.deepEqual(x.value.counts,{executed:1,reused:1});assert(!x.value.passed);assert.equal(x.value.results.find(r=>r.id==='a').exit,1);});
test('repair changes input and retains unrelated child',()=>{put('dep-a.txt','good');const x=run();assert(x.value.passed);assert.deepEqual(x.value.counts,{executed:0,reused:2});});
test('original output corruption causes execution rather than cached pass',()=>{const x=run(),r=R.readReceipt(cache,x.value.results[0].key);fs.writeFileSync(path.join(cache,r.raw.stdout.path),'tampered');const y=run();assert.deepEqual(y.value.counts,{executed:1,reused:1});assert(y.value.passed);});
test('missing original output causes execution',()=>{const x=run(),r=R.readReceipt(cache,x.value.results[1].key);fs.unlinkSync(path.join(cache,r.raw.stderr.path));assert.deepEqual(run().value.counts,{executed:1,reused:1});});
test('missing required input cannot reuse',()=>{fs.unlinkSync(path.join(root,'dep-b.txt'));const x=run();assert(!x.value.passed);assert.equal(x.value.counts.executed,1);put('dep-b.txt','good');});
test('stale dependency source never becomes reusable proof',()=>{const f=kit+'tests/a.js';put(f,fs.readFileSync(path.join(root,f),'utf8')+'\n// source changed');const x=run();assert.equal(x.value.results[0].action,'execute');assert.equal(x.value.results[0].reusable,false);assert.equal(run().value.results[0].action,'execute');contract();});
test('fresh reviewed source can be retained again',()=>{assert.equal(run().value.results[0].action,'execute');assert.deepEqual(run().value.counts,{executed:0,reused:2});});
test('external baseline requires exact ledger SHA',()=>{const x=run(),target=path.join(root,'new-cache');const y=run({cache:target,baselines:[{path:x.report,sha256:x.sha256}]});assert.deepEqual(y.value.counts,{executed:0,reused:2});assert.throws(()=>run({cache:target,baselines:[{path:x.report,sha256:'0'.repeat(64)}]}),/changed/);});
test('changed environment invalidates observations',()=>{process.env.PLATFORM_LEDGER_TEST_ENV='new';const x=run();assert.equal(x.value.counts.executed,2);delete process.env.PLATFORM_LEDGER_TEST_ENV;});
test('each declaration isolates changes to another child',()=>{const x=run();assert.deepEqual(x.value.counts,{executed:0,reused:2});});
test('malformed declaration fails closed',()=>{const f=path.join(root,'bad.json');fs.writeFileSync(f,'{}');assert.throws(()=>run({contracts:f}),/Invalid/);});
test('concurrent consumers use one producer per key',()=>{const env={...process.env};const script=`const R=require(${JSON.stringify(path.resolve(__dirname,'suite-runner.cjs'))});const cp=require('child_process');const files=['x','y'].map(n=>${JSON.stringify(path.join(root,'concurrent'))}+'/'+n+'.json');const code=n=>'const R=require('+JSON.stringify(${JSON.stringify(path.resolve(__dirname,'suite-runner.cjs'))})+');R.run('+JSON.stringify({tree:${JSON.stringify(root)},contracts:${JSON.stringify(path.join(root,'contracts.json'))},cache:${JSON.stringify(path.join(root,'concurrent-cache'))},report:files[n],runId:'concurrent'})+');';Promise.all(files.map((_,i)=>new Promise((ok,no)=>{const c=cp.spawn(process.execPath,['-e',code(i)],{stdio:'inherit'});c.on('exit',n=>n?no(Error(n)):ok());}))).catch(e=>{console.error(e);process.exitCode=1;});`;const p=cp.spawnSync(process.execPath,['-e',script],{encoding:'utf8',env,timeout:15000});assert.equal(p.status,0,p.stderr);const rows=['x','y'].map(n=>JSON.parse(fs.readFileSync(path.join(root,'concurrent',n+'.json'))));assert.equal(rows.reduce((s,r)=>s+r.counts.executed,0),2);});
test('tool-call metadata does not invalidate actual observations',()=>{const old=process.env.CODEX_TOOL_CALL_ID;const before=run();process.env.CODEX_TOOL_CALL_ID='different-tool-call';const after=run();assert.deepEqual(after.value.counts,{executed:0,reused:2});assert.equal(after.value.results[0].producer.id,before.value.results[0].producer.id);if(old===undefined)delete process.env.CODEX_TOOL_CALL_ID;else process.env.CODEX_TOOL_CALL_ID=old;});
test('same-path internal file override content is a real dependency',()=>{const f=path.join(root,'override.txt');put('override.txt','first');const d=JSON.parse(fs.readFileSync(path.join(root,'contracts.json')));d.entries[0].environment_inputs=['STORAGE_GUARD'];process.env.STORAGE_GUARD=f;const first=R.snapshot(root,d.entries[0]);put('override.txt','second');const second=R.snapshot(root,d.entries[0]);assert.notEqual(first.key,second.key);assert(first.fresh&&second.fresh);delete process.env.STORAGE_GUARD;});
test('override directory membership changes its fingerprint',()=>{put('override-dir/one.txt','one');const d=JSON.parse(fs.readFileSync(path.join(root,'contracts.json')));d.entries[0].environment_inputs=['KIT_DIR'];process.env.KIT_DIR=path.join(root,'override-dir');const first=R.snapshot(root,d.entries[0]);put('override-dir/two.txt','two');assert.notEqual(first.key,R.snapshot(root,d.entries[0]).key);delete process.env.KIT_DIR;});
console.log(JSON.stringify({passed:!process.exitCode,controls:count}));if(!process.exitCode)fs.rmSync(root,{recursive:true,force:true});
