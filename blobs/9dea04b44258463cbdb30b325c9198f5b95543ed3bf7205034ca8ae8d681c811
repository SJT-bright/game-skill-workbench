'use strict';
const assert = require('node:assert/strict');
const Owner = require('../assets/common-ui/ModalOwner');
function node(name, parent = null) { return {name, parent, active: true, destroyed: 0, destroy() { this.destroyed++; for (const n of this.children || []) n.destroy(); }}; }
function ui(name = 'SameName') { const root=node(name),view=node('Panel',root),mask=node('Mask',root); root.children=[mask,view]; return {root,view,mask}; }
let passed=0;
function test(name, f) { f(); passed++; process.stdout.write('PASS '+name+'\n'); }
test('rapid opens attach to the same in-flight session',()=>{const o=new Owner(),a=o.begin('shop'),b=o.begin('shop');assert(a.created);assert(!b.created);assert.equal(a.session,b.session);});
test('same-name independent modals close their own container, never the first name match',()=>{const o=new Owner(),a=o.begin('shop',{singleton:false}).session,b=o.begin('shop',{singleton:false}).session,x=ui(),y=ui();a.mount(x.root,x.view,x.mask);b.mount(y.root,y.view,y.mask);b.close();assert.equal(y.mask.destroyed,1);assert.equal(x.mask.destroyed,0);assert(a.current());a.close();assert.equal(x.mask.destroyed,1);});
test('close during load, reopen, late result cannot cover the new modal',()=>{const o=new Owner(),a=o.begin('shop').session;a.close();const b=o.begin('shop').session,x=ui(),late=ui();b.mount(x.root,x.view,x.mask);assert.equal(a.mount(late.root,late.view,late.mask),false);assert.equal(late.mask.destroyed,1);assert.equal(x.mask.destroyed,0);assert.equal(a.close(),false);assert(b.current());});
test('late callback cannot dispose nodes owned by another session',()=>{const o=new Owner(),a=o.begin('shop').session;a.close();const b=o.begin('shop').session,x=ui();b.mount(x.root,x.view,x.mask);assert.throws(()=>a.mount(x.root,x.view,x.mask),/another session/);assert.equal(x.mask.destroyed,0);});
test('different keys keep independent locks; close is idempotent',()=>{const o=new Owner(),a=o.begin('shop').session,b=o.begin('ad').session;let shop=1,ad=1;a.hold(()=>shop--);b.hold(()=>ad--);a.close();a.close();assert.equal(shop,0);assert.equal(ad,1);o.dispose();o.dispose();assert.equal(ad,0);assert.throws(()=>o.begin('shop'),/no live owner/);});
test('owner teardown revokes all operations before late completion',()=>{let alive=true;const o=new Owner({isAlive:()=>alive}),a=o.begin('x').session;alive=false;const x=ui();assert(!a.mount(x.root,x.view,x.mask));assert.equal(x.root.destroyed,1);o.dispose();assert(!a.current());});
test('cleanup failure does not strand other locks or sessions',()=>{const o=new Owner(),a=o.begin('a').session,b=o.begin('b').session;let n=0;a.hold(()=>{throw Error('external cleanup failed')});a.hold(()=>n++);b.hold(()=>n++);assert.throws(()=>o.dispose(),/cleanup failed/);assert.equal(n,2);assert.equal(o.entries.size,0);});
test('reentrant cleanup cannot let the old session remove the replacement',()=>{const o=new Owner(),a=o.begin('shop').session;let b;a.hold(()=>{b=o.begin('shop').session});a.close();assert(b.current());assert.equal(o.begin('shop').session,b);});
test('shared resources and root-level foreign blockers are rejected',()=>{const o=new Owner(),a=o.begin('shop').session,x=ui();x.mask.parent=null;assert.throws(()=>a.mount(x.root,x.view,x.mask),/share their session container/);assert.equal(x.mask.destroyed,0);});
test('duplicate callback may reuse its own mount but not replace it',()=>{const o=new Owner(),a=o.begin('shop').session,x=ui(),y=ui();assert(a.mount(x.root,x.view,x.mask));assert(a.mount(x.root,x.view,x.mask));assert.throws(()=>a.mount(y.root,y.view,y.mask),/duplicate mount/);});
test('a child modal must use a sibling container; a parent close cannot strand its token',()=>{const o=new Owner(),a=o.begin('settings').session,b=o.begin('confirm').session,x=ui(),y=ui();a.mount(x.root,x.view,x.mask);y.root.parent=x.view;assert.throws(()=>b.mount(y.root,y.view,y.mask),/another session/);b.close();a.close();assert.equal(o.entries.size,0);});
test('a later parent cannot absorb an existing session subtree',()=>{const o=new Owner(),a=o.begin('confirm').session,b=o.begin('settings').session,x=ui(),y=ui();a.mount(x.root,x.view,x.mask);x.root.parent=y.view;assert.throws(()=>b.mount(y.root,y.view,y.mask),/another session/);assert.equal(x.root.destroyed,0);});
test('stale cleanup protects a newer owned subtree even when the root object differs',()=>{const o=new Owner(),old=o.begin('old').session;old.close();const current=o.begin('new').session,x=ui(),late=ui();current.mount(x.root,x.view,x.mask);x.root.parent=late.view;assert.throws(()=>old.mount(late.root,late.view,late.mask),/another session/);assert.equal(x.root.destroyed,0);assert(current.current());});
console.log(JSON.stringify({passed,failed:0,boundary:'helper ownership semantics; not a rendered game or physical-device result'}));
