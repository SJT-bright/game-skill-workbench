'use strict';
const assert=require('node:assert/strict');
const acorn=require('./vendor/acorn.cjs');
const {scan,scanAST}=require('./scan_ad_sdk_capabilities.cjs');
const rows=[];
function test(name,code,bad=false){let r;try{r=scan(code,'fixture.js')}catch(error){throw new Error(name+': '+error.message)};assert.equal(r.findings.length>0,bad,name+' '+JSON.stringify(r));for(const x of r.findings){assert.ok(x.rule&&x.reason);assert.ok(Number.isInteger(x.line)&&Number.isInteger(x.column));}rows.push({name,passed:true});}
const direct = guard => `function run(){var sdk=TTMinis.game;${guard};sdk.createRewardedVideoAd({adUnitId:'x'});}`;
const helper = predicate => `function getSDK(){return TTMinis.game} function ok(e,t){if(!e||typeof e[t]!=='function')return false;return ${predicate}} function Ad(){this.getApi=getSDK} Ad.prototype.show=function(){var a;try{a=this.getApi()}catch(e){a=null}if(!ok(a,'createRewardedVideoAd'))return {status:'unsupported'};return a.createRewardedVideoAd({});}`;
test('direct_negation_returns_unsupported',direct("if(typeof sdk.canIUse==='function'&&!sdk.canIUse('createRewardedVideoAd'))return {status:'unsupported'}"),true);
test('direct_negation_returns_empty',direct("if(!sdk.canIUse('createRewardedVideoAd'))return"),true);
test('minified_strict_true_predicate',helper('!0===e.canIUse(t)'),true);
test('unminified_strict_true_predicate',helper('e.canIUse(t) === true'),true);
test('correct_optional_capability_predicate',helper("typeof e.canIUse!=='function'||e.canIUse(t)!==false"));
test('explicit_false_rejection',direct("if(typeof sdk.canIUse==='function'&&sdk.canIUse('createRewardedVideoAd')===false)return {status:'unsupported'}"));
test('namespace_loop_continue',`function resolve(method){var all=[TTMinis.game,tt];for(var i=0;i<all.length;i++){var sdk=all[i];if(typeof sdk.canIUse==='function'&&!sdk.canIUse(method))continue;return sdk}return null}function Ad(){this.getSDK=resolve} Ad.prototype.show=function(){var sdk=this.getSDK('createRewardedVideoAd');return sdk.createRewardedVideoAd({})}`,true);
test('correct_namespace_loop',`function resolve(method){var all=[TTMinis.game,tt];for(var i=0;i<all.length;i++){var sdk=all[i];if(typeof sdk.canIUse==='function'&&sdk.canIUse(method)===false)continue;return sdk}return null}function Ad(){this.getSDK=resolve} Ad.prototype.show=function(){var sdk=this.getSDK('createRewardedVideoAd');return sdk.createRewardedVideoAd({})}`);
test('other_platform_capability',direct("if(!sdk.canIUse('showToast'))return {status:'unsupported'}"));
test('comments_and_strings',`var note="if(!sdk.canIUse('createRewardedVideoAd'))return unsupported";/*var sdk=tt;sdk.createRewardedVideoAd()*/`);
test('no_ad_factory_not_a_proof',"var sdk=TTMinis.game;if(!sdk.canIUse('createRewardedVideoAd'))return false;");
test('local_same_named_object',"var sdk={canIUse:function(){return false},createRewardedVideoAd:function(){}};if(!sdk.canIUse('createRewardedVideoAd'))return false;sdk.createRewardedVideoAd({});");
test('local_namespace_shadow',"function run(TTMinis){var sdk=TTMinis.game;if(!sdk.canIUse('createRewardedVideoAd'))return false;sdk.createRewardedVideoAd({})}");
test('block_shadow',"var sdk=tt;{let sdk={canIUse(){return false},createRewardedVideoAd(){}};if(!sdk.canIUse('createRewardedVideoAd'))return false;sdk.createRewardedVideoAd({})}");
test('local_predicate_shadow',helper("typeof e.canIUse!=='function'||e.canIUse(t)!==false")+";function other(){function ok(a,b){return a.canIUse(b)===true}const local={canIUse(){return true},createRewardedVideoAd(){}};if(!ok(local,'createRewardedVideoAd'))return false;local.createRewardedVideoAd({})}");
test('return_selected_sdk_is_not_denial',direct("if(!sdk.canIUse('createRewardedVideoAd'))return sdk"));
test('same_field_name_different_module',`(function(){function getSDK(){return TTMinis.game}function A(){this.getSDK=getSDK}A.prototype.show=function(){return this.getSDK('createRewardedVideoAd').createRewardedVideoAd({})}})();(function(){function B(){this.getSDK=()=>({canIUse(){return true}})}B.prototype.other=function(){var sdk=this.getSDK();if(!sdk.canIUse('createRewardedVideoAd'))return false;return sdk.createRewardedVideoAd({})}})();`);
test('unrelated_call_after_explicit_false',direct("if(sdk.canIUse('createRewardedVideoAd')===false){if(!sdk.canIUse('showToast'))return {status:'unsupported'}}"));
test('mutable_unknown_receiver_not_proven',"function x(){var sdk=tt;sdk=getLocal();if(!sdk.canIUse('createRewardedVideoAd'))return false;sdk.createRewardedVideoAd({})}");
const sample=direct("if(!sdk.canIUse('createRewardedVideoAd'))return false");assert.deepEqual(scanAST(acorn.parse(sample,{ecmaVersion:'latest',locations:true}),'same.js'),scan(sample,'same.js'));rows.push({name:'existing_ast_same_result',passed:true});
console.log(JSON.stringify({passed:true,count:rows.length,rows},null,2));
